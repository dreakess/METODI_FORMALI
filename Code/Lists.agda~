   reverse( 0 :: 1 :: 2 :: [] ) == 2 :: 1 :: 0 :: []
                                = (2 :: 1 :: []) ++ 0
                                = reverse (1 :: 2 :: []) :: (0 :: [])

   reverse (1 :: 2 :: []) = 2 :: 1 :: [] ipotesi induttiva

   T(n) = n - 1 + T(n - 1) = O(n²)

   
