data Σ (A : Set) (B : A → Set) : Set where
  _,_ : ∀(x : A) → B x → Σ A B


-- il Σ è una geralizzazione del prodotto

_x_ : Set → Set → Set
A x B = Σ A (λ _ → B)

fst : ∀{A : Set} → {B : A → Set} → Σ A B → A
fst (x , _) = x

snd : ∀{A : Set} → {B : A → Set} → (p : Σ A B) → B (fst p)
snd (_ , y) = y

-- Esempi di uso di tipi Σ


ℕ⁺ : Set   -- si scrive /bN/^+
ℕ⁺ = Σ ℕ (λ z → z != 0) -- tipo dei naturali diversi da 0

-- notazione equivalente

-- ℕ⁺ = Σ ℕ (_ != 0)


List⁺ : Set → Set
List⁺ A = Σ (List A) (_!= []) 

head : ∀{A : Set} → List⁺ A → A
head ([] , y) = ex-falso (y refl) -- [] != [] == ([] == []) → ⊥
head ((x :: xs) , y) = x


-- l'ex-falso ci serve per scaricare non dover trattare i casi impossibili


∃ : ∀ {A : Set} (B : A → Set) → Set
∃ {A} B = Σ A B

∃-syntax = ∃
syntax ∃-syntax (λ x → B) = ∃[ x ] B



pred : ∀(p : ℕ⁺) → ∃[ z ] (fst p == succ z)
pred (zero , y) = ex-falso (y refl)
pred (succ x , y) = x , refl 


-- esprimiamo il predicato di divisibilità

_∣_ : ℕ → ℕ → Set               -- ∣ si scrive /|
x ∣ y = ∃[ z ] (z * x == y)


∣-refl : ∀ x → x ∣ x
∣-refl x = 1 , *-unit-l x

