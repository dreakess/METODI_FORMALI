⊢trans : ∀(x y z : ℕ) → x ∣ y → y ∣ z → x ∣ z
⊢trans x y z (p , p1) (q , q1) = q * p , th
  where
    th : q * p * x == z
    th =
      begin
        q * p * x
          ⟨ *-assoc q p x ⟩==
          q * (p * x) ==⟨ cong (λ z → q * z ) (p1) ⟩
          q * y ==⟨ q1 ⟩
          z 
      end


